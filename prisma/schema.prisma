// WiseCard — Prisma schema
// Multi-tenant root: Organization → Users, Contacts, Cases, Tasks, Activities.
// Auth.js adapter models included for future OAuth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  contacts   Contact[]
  cases      Case[]
  tasks      Task[]
  activities Activity[]
  scenarios  Scenario[]
}

enum Role {
  PRINCIPAL
  ADVISOR
  ASSISTANT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(ADVISOR)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accounts     Account[]
  sessions     Session[]
  tasks        Task[]        @relation("TaskAssignee")
  activities   Activity[]    @relation("ActivityAuthor")
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Auth.js adapter models (used when Google/OAuth is added later)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum ContactType {
  LEAD
  CLIENT
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  SUBMITTED
  APPROVED
  CLOSED
  LOST
}

enum CasePurpose {
  PURCHASE
  REFINANCE
  EQUITY
  OTHER
}

enum ActivityChannel {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type   ContactType @default(LEAD)
  name   String
  phone  String?
  email  String?
  source String?
  stage  String?

  cases      Case[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Case {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title   String?
  status  CaseStatus  @default(NEW)
  purpose CasePurpose @default(PURCHASE)
  amount  Int? // requested loan amount in ILS

  borrowers  Borrower[]
  property   Property?
  tasks      Task[]
  activities Activity[]
  scenarios  Scenario[]

  nextAction         String?
  followUpAt         DateTime?
  expectedCompletion DateTime?
  feeAgreed          Int            @default(0)
  feePaid            Int            @default(0)
  notes              String?
  documents          CaseDocument[]
  bankOffers         BankOffer[]
  appointments       Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS_OWNER
  PENSIONER
  OTHER
}

// A household member on the loan. Org scoping is via the parent case.
model Borrower {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name               String
  monthlyIncome      Int            @default(0) // net ILS / month
  monthlyObligations Int            @default(0) // existing loan payments ILS / month
  employment         EmploymentType @default(SALARIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
}

// LTV basis per BOI directive: 75% first home / 70% upgrader / 50% investment.
// Refinancing requires comparison to the original exposure. Non-purchase
// concessions are discretionary and are assessed separately by the simulator.
enum LtvBasis {
  FIRST_HOME
  UPGRADER
  INVESTMENT
  REFINANCE
  CONSOLIDATION
}

enum PropertyType {
  APARTMENT
  HOUSE
  PENTHOUSE
  LAND
  OTHER
}

model Property {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  value    Int // appraised / purchase value in ILS
  city     String?
  type     PropertyType @default(APARTMENT)
  ltvBasis LtvBasis     @default(FIRST_HOME)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  title String
  dueAt DateTime?
  done  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([caseId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  channel ActivityChannel @default(NOTE)
  body    String

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([caseId])
}

// A saved mortgage mix (תמהיל) attached to a case. Legs hold the per-track
// allocation: [{ type, pct, rate }]. Inputs + computed totals are snapshotted.
model Scenario {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  label        String?
  amount       Int
  termMonths   Int
  cpi          Float
  firstPayment Float
  totalPaid    Float
  feasible     Boolean
  legs         Json
  snapshot     Json? // versioned engine input; null for legacy records

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Financial-data center (global reference data — not tenant-scoped)
// Series: BOI_RATE, CPI_INDEX, CPI_YOY. Synced from BOI Edge API + CBS.
// ---------------------------------------------------------------------------

model MarketReading {
  id        String   @id @default(cuid())
  series    String
  date      DateTime
  value     Float
  createdAt DateTime @default(now())

  @@unique([series, date])
  @@index([series])
}

enum DocumentStatus {
  MISSING
  RECEIVED
  VERIFIED
  NOT_REQUIRED
}

enum BankOfferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model CaseDocument {
  id        String         @id @default(cuid())
  caseId    String
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title     String
  status    DocumentStatus @default(MISSING)
  url       String?
  expiresAt DateTime?
  notes     String?
  updatedAt DateTime       @updatedAt

  @@unique([caseId, title])
  @@index([caseId, status])
}

model BankOffer {
  id           String          @id @default(cuid())
  caseId       String
  case         Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  bank         String
  banker       String?
  phone        String?
  status       BankOfferStatus @default(DRAFT)
  amount       Int
  termMonths   Int
  firstPayment Int
  totalPayment Int?
  validUntil   DateTime?
  selected     Boolean         @default(false)
  tracks       Json
  url          String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([caseId, status])
}

model Appointment {
  id              String            @id @default(cuid())
  caseId          String
  case            Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  advisorId       String
  advisor         User              @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  title           String
  startsAt        DateTime
  durationMinutes Int               @default(60)
  location        String?
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([advisorId, startsAt])
  @@index([caseId])
}
